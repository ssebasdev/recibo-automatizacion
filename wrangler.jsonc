{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "recibo-automatizacion",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-02",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB_RECIBOS",
			"database_name": "db-recibos",
			"database_id": "47701bc5-7351-4cd8-b73c-d1c77877d8b4",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_RECIBO",
			"bucket_name": "r2-recibo",
			"remote": true
		}
	],
	"workflows": [
		{
			"binding": "WORKFLOW_RECIBO_NOTIFICAR",
			"class_name": "WorkflowReceipt",
			"name": "workflow_recibo_notificar"
		},
		{
			"binding": "WORKFLOW_RECIBO_REINTENTAR",
			"class_name": "WorkflowReceiptRetry",
			"name": "workflow_recibo_reintentar"
		}
	],
	"secrets": {
		"required": [
			"ACCESS_CLIENT_ID_CLOUDFLARE",
			"ACCESS_CLIENT_SECRET_CLOUDFLARE",
			"GOOGLE_AI_API_KEY",
			"TOKEN_SECRET_API_PROVEEDOR",
			"CHAT_ID_LOGS_TELEGRAM"
		]
	},
	"triggers": {
		"crons": [
			"0 7 10-20 * *",
			"0 8 10-20 * *"
		]
	}
}